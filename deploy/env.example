# ~/.config/zammad-archive/env   (chmod 600)
# Zammad: Profile -> Token Access, permission ticket.agent
ZAMMAD_TOKEN=
# Pseudonym key: python3 -c "import secrets; print(secrets.token_hex(32))"
# Back it up together with the archive. Losing it changes all future pseudonyms.
ZAMMAD_ARCHIVE_SECRET=
# Same value as the podman secret meili_master_key
MEILI_MASTER_KEY=
