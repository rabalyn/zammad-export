# .env next to compose.yaml   (chmod 600, never commit)
# Zammad: Profile -> Token Access, permission ticket.agent
ZAMMAD_TOKEN=
# Pseudonym key: openssl rand -hex 32
# Back it up together with the archive. Losing it changes all future pseudonyms.
ZAMMAD_ARCHIVE_SECRET=
# Meilisearch master key: openssl rand -hex 32
MEILI_MASTER_KEY=
# Port of the search UI on the host
WEB_PORT=8080
