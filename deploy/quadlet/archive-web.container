[Unit]
Description=Caddy: search UI + attachment files for the Zammad ticket archive
Requires=meilisearch.service
After=meilisearch.service

[Container]
Image=docker.io/library/caddy:2.10
ContainerName=archive-web
Network=zammad-archive.network
PublishPort=8080:8080
Volume=%h/zammad-archive/app/deploy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=%h/zammad-archive/app/web:/srv/web:ro,Z
# :z (shared label) because the exporter on the host writes here (ADR 0008)
Volume=%h/zammad-archive/archive/tickets:/srv/archive/tickets:ro,z

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
