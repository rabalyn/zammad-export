[Unit]
Description=Export Zammad tickets into the archive and update the search index
Wants=meilisearch.service
After=meilisearch.service

[Service]
Type=oneshot
WorkingDirectory=%h/zammad-archive
EnvironmentFile=%h/.config/zammad-archive/env
ExecStart=%h/zammad-archive/venv/bin/zammad-archive -c %h/zammad-archive/config.yaml run
Nice=10
TimeoutStartSec=6h
